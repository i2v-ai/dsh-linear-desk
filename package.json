{
  "name": "dsh-linear-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read Linear issues inside DeepSeek Harness without opening the Linear web app.",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i2v-ai/dsh-linear-desk.git"
  },
  "homepage": "https://github.com/i2v-ai/dsh-linear-desk#readme",
  "bugs": {
    "url": "https://github.com/i2v-ai/dsh-linear-desk/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "linear",
    "mcp"
  ]
}
