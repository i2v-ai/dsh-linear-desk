{
  "name": "dsh-linear-desk",
  "version": "0.1.0",
  "type": "module",
  "description": "Read Linear issues inside DeepSeek Harness without opening the Linear web app.",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "locale/*.json",
    "docs",
    "icon.svg",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node test/host-check.mjs && node test/locale-check.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "i2v.ai (https://i2v.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i2v-ai/dsh-linear-desk.git"
  },
  "homepage": "https://github.com/i2v-ai/dsh-linear-desk#readme",
  "bugs": {
    "url": "https://github.com/i2v-ai/dsh-linear-desk/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "linear",
    "linear-app",
    "issue-tracker",
    "mcp",
    "sidebar",
    "panel"
  ]
}
